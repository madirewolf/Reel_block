<?xml version="1.0" encoding="utf-8"?>
<!-- Square switch track: filled when on, outlined when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_on_surface" />
            <size android:width="52dp" android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/rb_on_surface_muted" />
            <size android:width="52dp" android:height="28dp" />
        </shape>
    </item>
</selector>
