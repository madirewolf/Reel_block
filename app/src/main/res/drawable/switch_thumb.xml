<?xml version="1.0" encoding="utf-8"?>
<!-- Square switch thumb, inset inside a 28dp cell. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="28dp" android:height="28dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="18dp" android:height="18dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rb_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="28dp" android:height="28dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:width="18dp" android:height="18dp" android:gravity="center">
                <shape android:shape="rectangle">
                    <solid android:color="@color/rb_on_surface_muted" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
