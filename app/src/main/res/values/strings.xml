    <!-- Shown by Android in Settings > Accessibility. -->
    <string name="accessibility_service_label">Reel It In</string>
    <string name="accessibility_service_description">Blocks Instagram Reels. A reel a friend sends you in a DM can still play, one at a time. Reel It In only reads Instagram\'s screen. No other apps.</string>
