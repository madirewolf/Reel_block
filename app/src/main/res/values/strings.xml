    <!-- Shown before sending you to Accessibility settings. -->
    <string name="disclosure_title">Before you turn it on</string>
    <string name="disclosure_body">Reel It In uses Android\'s accessibility service to read Instagram\'s screen: view names, labels and visible text. It uses this only to tell when a reel is showing and where you opened it, so it can cover the reel and go back.\n\nIt doesn\'t read other apps, record your messages or what you type, or take screenshots. Nothing leaves your phone: the app has no internet access.</string>
