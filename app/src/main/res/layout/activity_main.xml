<?xml version="1.0" encoding="utf-8"?>
<!-- One screen: title and status, then Setup 1-2-3, then Options. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rb_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/rb_on_surface"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_mark"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/rb_status_setup" />

            <TextView
                android:id="@+id/status_text"
                style="@style/RB.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/status_setup"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== Setup ===== -->
        <TextView
            style="@style/RB.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="12dp"
            android:text="@string/section_setup" />

        <View style="@style/RB.Divider" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/step_1_mark"
                style="@style/RB.StepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_todo"
                android:text="1"
                android:textColor="@color/rb_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_1_title" />

                <TextView
                    android:id="@+id/step_1_body"
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/step_1_body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/step_1_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_open" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/step_2_mark"
                style="@style/RB.StepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_todo"
                android:text="2"
                android:textColor="@color/rb_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_2_title" />

                <TextView
                    android:id="@+id/step_2_body"
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/step_2_body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/step_2_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_allow" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/step_3_mark"
                style="@style/RB.StepNumber"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_step_todo"
                android:text="3"
                android:textColor="@color/rb_on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step_3_title" />

                <TextView
                    android:id="@+id/step_3_body"
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/step_3_body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/step_3_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_allow" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <!-- ===== Options ===== -->
        <TextView
            style="@style/RB.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="12dp"
            android:text="@string/section_options" />

        <View style="@style/RB.Divider" />

        <LinearLayout
            android:id="@+id/row_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/option_block_title" />

                <TextView
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/option_block_body" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_blocking"
                style="@style/RB.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/toggle_blocking"
                app:switchMinWidth="52dp" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <LinearLayout
            android:id="@+id/row_dm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/option_dm_title" />

                <TextView
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/option_dm_body" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_dm_reels"
                style="@style/RB.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/toggle_dm_reels"
                app:switchMinWidth="52dp" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <LinearLayout
            android:id="@+id/row_feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RB.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/option_feed_title" />

                <TextView
                    style="@style/RB.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/option_feed_body" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_feed_reels"
                style="@style/RB.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/toggle_feed_reels"
                app:switchMinWidth="52dp" />
        </LinearLayout>

        <View style="@style/RB.Divider" />

        <LinearLayout
            android:id="@+id/row_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                style="@style/RB.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/view_log"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
