<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/log_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/rb_on_surface_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/log_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="@color/rb_chip_warn_fg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/log_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rb_on_surface_muted"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <TextView
        android:id="@+id/log_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/rb_on_surface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/log_sig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/rb_on_surface_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/log_diag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textColor="@color/rb_on_surface_muted"
        android:textSize="11sp" />

</LinearLayout>
